# Скопируй в .env для локального запуска.
# На Render эти же имена задаются в Dashboard → Environment.

PORT=3000

# Секретный токен, который телефон/сайт передают в заголовке Authorization: Bearer <TOKEN>
# чтобы никто посторонний не мог дергать твой сервер. Придумай длинную случайную строку.
AUTH_TOKEN=change-me-to-a-long-random-string

# Mistral AI (chat + распознавание речи)
MISTRAL_API_KEY=

# Cartesia (озвучка ответа)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# ntfy — топик для push-уведомлений. Топик = произвольная секретная строка
# (например jarvis-a8f3c9d1), её же указываешь в приложении при подписке.
# Можно использовать публичный https://ntfy.sh или поднять свой сервер.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=change-me-jarvis-topic
